<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>

    <!-- Если вы используете группу com.example.mysite, лучше укажите её здесь,
         но это не критично, если папки совпадают -->
    <groupId>com.example</groupId>
    <artifactId>mysite</artifactId>
    <version>1.0</version>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.17.0</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Плагин для локального запуска (оставляем) -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <configuration>
                    <!-- ВАЖНО: Путь к вашему классу с методом main -->
                    <mainClass>com.example.mysite.MysiteApplication</mainClass>
                </configuration>
            </plugin>

            <!-- Плагин для сборки "толстого" JAR для Docker -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.6.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <!-- ВАЖНО: Указываем правильный класс, который содержит main -->
                            <mainClass>com.example.mysite.MysiteApplication</mainClass>
                        </manifest>
                    </archive>
                    <descriptorRefs>
                        <!-- Эта настройка собирает все зависимости внутрь JAR -->
                        <descriptorRef>jar-with-dependencies</descriptorRef>
                    </descriptorRefs>
                </configuration>
                <executions>
                    <execution>
                        <id>make-assembly</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>